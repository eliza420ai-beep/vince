# OTAKU_EXCHANGE_NATIVE_STOPS_ALWAYS=false
#
# Hyperliquid perps sidecar (optional): separate process holds HL keys; Otaku POSTs orders only.
# See docs/OTAKU_HL_SIDECAR.md and docs/PRD_LIVE_HYPERLIQUID_PERPS.md
# OTAKU_HL_SIDECAR_URL=http://127.0.0.1:8787
# OTAKU_HL_SIDECAR_BEARER=
# OTAKU_HL_SIDECAR_TIMEOUT_MS=20000
# COINBASE_ADVANCED_TRADE_KEY_NAME=
# COINBASE_ADVANCED_TRADE_KEY_SECRET=

# BANKR (swaps, limit orders, DCA)
# BANKR_API_KEY=
