# -----------------------------------------------------------------------------
SENTINEL_DISCORD_APPLICATION_ID=
SENTINEL_DISCORD_API_TOKEN=
# SENTINEL_WEEKLY_ENABLED=true
# SENTINEL_DAILY_ENABLED=false
# SENTINEL_DAILY_HOUR_UTC=8
# Write Top pick / #1 weekly suggestion as task brief to docs/standup/openclaw-queue/ for AI coding agents
# SENTINEL_SHIP_WRITE_OPENCLAW_TASK=true
# SENTINEL_WEEKLY_WRITE_OPENCLAW_TASK=true
# SENTINEL_PRD_OUTPUT_DIR= (default: STANDUP_DELIVERABLES_DIR/prds or standup-deliverables/prds)
# CURSOR_MAX_COST_MONTHLY=

# VINCE spend alerts (logs SPEND_ALERT_BREACH for Railway/Log alerts when estimated LLM spend crosses this threshold).
# Uses `run_event` logs + VINCE_USAGE_COST_PER_1K_TOKENS (or default blended estimate).
# Set to a number like `100` to alert when monthly spend exceeds $100.
# VINCE_SPEND_ALERT_MONTHLY_USD=
# Target repo URL for Sentinel issue suggestions
# SENTINEL_TARGET_REPO_URL=https://github.com/eliza420ai-beep/vince
# Pilot: plugin-agent-orchestrator + plugin-autonomous on Sentinel runtime
# SENTINEL_ENABLE_AGENT_ORCHESTRATOR=false
# SENTINEL_ENABLE_AUTONOMOUS=false

# -----------------------------------------------------------------------------
# v2 AGENT ROSTER — enable/disable individual agents
# -----------------------------------------------------------------------------
# v2 CORE (always on): VINCE data agent, Solus, Otaku, Forge.
# v1 agents have been migrated to portable skills — they default to DISABLED.
# See skills/ directory for each agent's portable SKILL.md.
#
# v1 → skill migration status:
#   ELIZA_ENABLED=false   → skills/eliza/SKILL.md  (Mac Mini + Perplexity Computer)
#   KELLY_ENABLED=false   → skills/kelly/SKILL.md  (Mac Mini + OpenClaw)
#   ECHO_ENABLED=false    → skills/echo/SKILL.md   (Dexter repo conviction layer)
#   SENTINEL_ENABLED=false → skills/sentinel/SKILL.md  (CLAUDE.md / AGENTS.md)
#   CLAWTERM_ENABLED=false → skills/clawterm/SKILL.md  (OpenClaw workspace)
#   ORACLE_ENABLED=false   → RETIRED — no migration; Polymarket never produced edge
#   NAVAL_ENABLED=false   → skills/naval/SKILL.md  (Dexter repo SOUL.md layer)
#
# To re-enable a v1 agent temporarily: set to true. Default is false (v2 slim mode).
ELIZA_ENABLED=false
KELLY_ENABLED=false
ECHO_ENABLED=false
SENTINEL_ENABLED=false
CLAWTERM_ENABLED=false
ORACLE_ENABLED=false
NAVAL_ENABLED=false

# -----------------------------------------------------------------------------
# FORGE (MLX AutoResearch — overnight self-optimization experiments)
# -----------------------------------------------------------------------------
# FORGE_ENABLED=true                  # Set false to disable all Forge activity
# FORGE_RUNTIME=mlx                   # mlx (Apple Silicon) | python (CPU fallback)
# FORGE_BUDGET_MINUTES=120            # Max wall-clock budget per nightly run
# FORGE_TARGET_METRIC=causal_uplift * sharpe * (1 - brier_score)
# FORGE_MAX_EXPERIMENTS=10            # Max mutations per run
# FORGE_NIGHTLY_HOUR_UTC=2            # Hour to trigger nightly run (0–23 UTC)
# FORGE_TELEGRAM_PUSH=true            # Push nightly summary to Telegram #forge/#ops
# FORGE_DAILY_REPORT_ENABLED=true     # Push daily deterministic Forge summary to forge/ops channels
# FORGE_DAILY_REPORT_HOUR_UTC=7       # UTC hour for daily summary push (0-23)
# FORGE_AUTO_MERGE=false              # Auto-merge winning PRs (false = human review)
# FORGE_OTAKU_MUTATION_REQUIRES_APPROVAL=true  # Require user confirmation for Otaku mutations (Phase 3)

# -----------------------------------------------------------------------------
# CLAWTERM (OpenClaw research terminal)
# -----------------------------------------------------------------------------
CLAWTERM_DISCORD_APPLICATION_ID=
CLAWTERM_DISCORD_API_TOKEN=

# -----------------------------------------------------------------------------
# FALLBACK DISCORD (when an agent has no *_DISCORD_* set)
# -----------------------------------------------------------------------------
DISCORD_APPLICATION_ID=
DISCORD_API_TOKEN=

