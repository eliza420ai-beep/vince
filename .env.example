# Stripe machine payments (Otaku — fiat settlement + MPP)
# Stripe acts as x402 facilitator (fiat settlement into Stripe balance)
# and MPP facilitator (cards, wallets, SPTs alongside crypto).
# Contact machine-payments@stripe.com for account enablement.
# Reference implementation: https://github.com/eliza420ai-beep/machine-payments
# STRIPE_SECRET_KEY=sk_...
# STRIPE_MACHINE_PAYMENTS_ENABLED=false
# MPP_ENABLED=false
# MPP_SECRET_KEY=              # random 32-byte base64 key for challenge binding
# STRIPE_PROFILE_ID=           # profile_... for SPT live-mode payments

