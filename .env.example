# =============================================================================
# VINCE — Environment Variables
# =============================================================================
# Copy to .env and fill in values. One model provider key (OpenAI or Anthropic)
# is required; everything else is optional. Per-agent keys let each agent use
# its own Discord app and tokens. See docs/CONFIGURATION.md and MULTI_AGENT.md.
# =============================================================================

# -----------------------------------------------------------------------------
# CORE — Required to run
# -----------------------------------------------------------------------------
# At least one model provider; embeddings need OpenAI or another provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override default models for agents that use Anthropic.
# The plugin's built-in default for TEXT_SMALL (claude-3-5-haiku-20241022) is deprecated;
# load-env.ts auto-sets ANTHROPIC_SMALL_MODEL=claude-haiku-4-20250414 when not set.
# ANTHROPIC_LARGE_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_LARGE_MODEL=claude-opus-4
# ANTHROPIC_SMALL_MODEL=claude-haiku-4-5-20251001

# -----------------------------------------------------------------------------
# CLAWROUTER — Smart LLM routing + x402 micropayments (Strategy 4: cost optimization)
# -----------------------------------------------------------------------------
# Routes each LLM request to the cheapest model that can handle it. 15-dimension
# weighted scoring, <1ms local routing, 30+ models across OpenAI/Anthropic/Google/
# DeepSeek/xAI/Moonshot. Pays per-request with USDC on Base (no API keys needed
# for routed models). See: https://github.com/BlockRunAI/ClawRouter
#
# Install:  curl -fsSL https://blockrun.ai/ClawRouter-update | bash
# Fund:     Send $5+ USDC (Base) to the wallet printed on install
# Wallet:   Auto-generated at ~/.openclaw/blockrun/wallet.key (or set below)
#
# IMPORTANT: Embeddings (text-embedding-3-small) stay on OpenAI directly.
# ClawRouter routes text generation only. Keep OPENAI_API_KEY set for embeddings.

# Master switch (default: false). When true, agents use ClawRouter proxy for text gen.
# CLAWROUTER_ENABLED=false

# Proxy port (default: 8402). ClawRouter runs at http://localhost:<port>/v1
# CLAWROUTER_PROXY_PORT=8402

# Wallet private key. Auto-generated on install; set to use your own (e.g. Otaku's).
# CLAWROUTER_WALLET_KEY=

# Default routing profile: auto | eco | premium | free
# auto    = balanced quality + cost (74-100% savings vs Opus)
# eco     = maximum cost savings (95.9-100% savings)
# premium = best quality only (0% savings, Opus-tier)
# free    = free tier only (gpt-oss-120b, $0)
# CLAWROUTER_DEFAULT_PROFILE=auto

# Per-agent profile overrides (when different from default).
# Trading-critical agents (VINCE, Solus) should pin premium or a specific model.
# High-volume low-stakes agents (Kelly, ECHO) benefit most from eco/auto.
# CLAWROUTER_PROFILE_VINCE=premium
# CLAWROUTER_PROFILE_ELIZA=auto
# CLAWROUTER_PROFILE_ECHO=eco
# CLAWROUTER_PROFILE_ORACLE=auto
# CLAWROUTER_PROFILE_SOLUS=premium
# CLAWROUTER_PROFILE_OTAKU=auto
# CLAWROUTER_PROFILE_KELLY=eco
# CLAWROUTER_PROFILE_SENTINEL=auto
# CLAWROUTER_PROFILE_CLAWTERM=auto

# Blended cost tracking (estimated $/1K tokens via ClawRouter; updates VINCE_USAGE_COST_PER_1K_TOKENS)
# CLAWROUTER_BLENDED_COST_PER_1K=0.002

# Local messaging: replies stay on local server (no Eliza Cloud). Set to false when deploying.
ELIZAOS_USE_LOCAL_MESSAGING=true
# ELIZAOS_API_KEY=

# Logging: fatal | error | warn | info | debug | trace (default: info)
LOG_LEVEL=

# Production API gating (@elizaos/server): required header X-API-KEY on /api and Socket.IO when set
# ELIZA_SERVER_AUTH_TOKEN=
# ENABLE_DATA_ISOLATION=false
# When true, set JWT_SECRET (or JWT_JWKS_URI / Privy / Ed25519 per server) and ELIZA_SERVER_ID if required
# ELIZA_SERVER_ID=
# Full map: docs/API_SECURITY_AND_PRODUCTION.md

# Sentry (optional)
SENTRY_LOGGING=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_SEND_DEFAULT_PII=

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Leave POSTGRES_URL empty for local PGLite. Use port 5432 (direct), not pooler.
POSTGRES_URL=
# PGLITE_DATA_DIR=/path/to/.elizadb
# POSTGRES_SSL_REJECT_UNAUTHORIZED=false
# ELIZA_ALLOW_DESTRUCTIVE_MIGRATIONS=true   # Only for local dev when migrations would drop tables

# Optional: VINCE paper-bot feature store → Supabase (see FEATURE-STORE.md)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# SHARED APIs (used by multiple agents)
# -----------------------------------------------------------------------------
# Web search (Eliza, Kelly). https://tavily.com
TAVILY_API_KEY=

# Token/market data. Free tier rate-limited; optional.
COINGECKO_API_KEY=
# COINMARKETCAP_API_KEY=
# COINDESK_API_KEY=
# COINCAP_API_KEY=
# DEXSCREENER_API_URL=https://api.dexscreener.com
# DEXSCREENER_RATE_LIMIT_DELAY=100

# Optional: Nansen, Dune, Santiment, Coinglass, Allium, OpenSea, MESSARI, etc.
# Financial Datasets (recommended for cached historical ticker insights / MCP parity)
# FINANCIAL_DATASETS_API_KEY=
# NANSEN_API_KEY=
# DUNE_API_KEY=
# SANTIMENT_API_KEY=
# COINGLASS_API_KEY=
# ALLIUM_API_KEY=
# OPENSEA_API_KEY=
# BIRDEYE_API_KEY=
# JUPITER_API_KEY=
# HELIUS_API_KEY=
# ZEROEX_API_KEY=
# ETHERSCAN_API_KEY=
# FIRECRAWL_API_KEY=
# OX_API_KEY=

# FAL AI — cloud Whisper transcription for YouTube uploads (better than auto-captions)
# Used by summarize CLI when set. https://fal.ai
# FAL_KEY=

# OpenRouter (optional; some agents use for fallback)
# OPENROUTER_API_KEY=
# OPENROUTER_SMALL_MODEL=
# OPENROUTER_LARGE_MODEL=

# Polymarket trading desk — Synth forecasts (Analyst edge). https://dashboard.synthdata.co
# SYNTH_API_KEY=
# SYNTH_API_URL=https://api.synthdata.co

# Polymarket desk — Risk agent (bankroll, sizing). For $690/day goal use ~$15K+ bankroll, 10% max position.
# POLYMARKET_DESK_WALLET_ADDRESS=
# POLYMARKET_DESK_BANKROLL_USD=15000
# POLYMARKET_DESK_KELLY_FRACTION=0.25
# POLYMARKET_DESK_MAX_POSITION_PCT=0.1
# POLYMARKET_DESK_MIN_SIZE_USD=5
# POLYMARKET_DESK_MAX_SIZE_USD=2000
# Optional: vary size by strategy for more varied P&L (JSON, e.g. overreaction 0.6x, synth 1.2x)
# POLYMARKET_DESK_STRATEGY_SIZE_MULTIPLIERS={"overreaction":0.6,"synth":1.2,"model_fair_value":1}

# Polymarket desk — Execution (Otaku only). CLOB + wallet for placing orders.
# POLYMARKET_DESK_LIVE_ENABLED=true   # Set to true only after proving paper win rate; otherwise desk stays paper-only.
# POLYMARKET_PRIVATE_KEY=     # or use EVM_PRIVATE_KEY
# POLYMARKET_CLOB_API_KEY=
# POLYMARKET_CLOB_SECRET=
# POLYMARKET_CLOB_PASSPHRASE=
# POLYMARKET_FUNDER_ADDRESS=  # proxy wallet that holds USDC
# POLYMARKET_CLOB_API_URL=https://clob.polymarket.com

# Polymarket desk — Performance agent (reports, TCA). Optional Discord.
# POLYMARKET_PERF_DISCORD_APPLICATION_ID=
# POLYMARKET_PERF_DISCORD_API_TOKEN=

# Polymarket desk — Schedule (recurring tasks). Risk 15m and Otaku 2m poll run when not false.
# POLYMARKET_DESK_SCHEDULE_ENABLED=true
# POLYMARKET_DESK_DEFAULT_CONDITION_ID=   # Required for hourly Oracle edge check (e.g. a Polymarket condition_id)

# Polymarket sentiment (Vince) — prediction-market odds → perps signal + Solus context; ECHO surfaces via POLYMARKET_VIBE.
# POLYMARKET_SENTIMENT_ENABLED=true
# POLYMARKET_SENTIMENT_REFRESH_MIN=15
# POLYMARKET_SENTIMENT_CONFIDENCE_FLOOR=40

# Polymarket Edge (Oracle) — overreaction + model_fair_value. Keep ANY_BINARY true for overreaction; fallback fetch helps model_fair_value get BTC threshold markets.
# EDGE_DISCOVERY_TAGS=bitcoin,daily,weekly,monthly,ethereum,solana
# EDGE_DISCOVERY_ANY_BINARY=true
# POLYMARKET_GAMMA_API_URL=   # optional override; used by edge discovery and arb
# EDGE_OVERREACTION_VELOCITY_PCT=5
# optional: EDGE_OVERREACTION_VELOCITY_PCT=3 to allow smaller velocity spikes (more overreaction signals)
# EDGE_OVERREACTION_MAX_UNDERDOG_PRICE=0.2
# EDGE_OVERREACTION_COOLDOWN_MS=900000
# EDGE_MODEL_MIN_EDGE_PCT=15
# EDGE_MODEL_COOLDOWN_MS=600000

# -----------------------------------------------------------------------------
# Polymarket Latency Arb (Oracle) — Binance spot + Polymarket CLOB WebSockets
# -----------------------------------------------------------------------------
# Paper by default; set POLYMARKET_ARB_LIVE=true for live execution (same CLOB creds as desk).
# POLYMARKET_ARB_BANKROLL_USD=1300
# POLYMARKET_ARB_MIN_EDGE_PCT=8
# POLYMARKET_ARB_KELLY_FRACTION=0.25
# POLYMARKET_ARB_MAX_POSITION_USD=200
# POLYMARKET_ARB_MAX_DAILY_TRADES=150
# POLYMARKET_ARB_LIVE=false
# POLYMARKET_ARB_MIN_LIQUIDITY_USD=1000
# POLYMARKET_ARB_MAX_SPREAD_PCT=5
# POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com   # Contract discovery (optional; default above)

# -----------------------------------------------------------------------------
# X / TWITTER (VINCE, ECHO, Eliza, Clawterm)
# -----------------------------------------------------------------------------
# Required for X research, pulse, vibe, sentiment. Basic tier or higher. See docs/X-API.md
X_BEARER_TOKEN=
# Optional: separate token per agent (avoids rate limit when multiple agents use X)
# ELIZA_X_BEARER_TOKEN=
# ECHO_X_BEARER_TOKEN=
# Optional: sentiment/background tokens
# X_BEARER_TOKEN_SENTIMENT=
# X_BEARER_TOKEN_BACKGROUND=
# X_LIST_ID=   # Curated list ID; when set, list sentiment feeds aggregator as XListSentiment (weight 0.4)
# X_LIST_SENTIMENT_CONFIDENCE_FLOOR=35   # Min list confidence to vote (default 35)
# X_RESEARCH_QUALITY_LIST_ID=
# X_SEARCH_MAX_RESULTS=60    # Posts to fetch for X_SEARCH (default 60; use 100 for deeper research)
# X_SENTIMENT_ENABLED=true
# X_SENTIMENT_USE_X_RESEARCH_PLUGIN=false   # When true + plugin-x-research loaded, trading sentiment uses topic+quality model
# X_NEWS_AS_AGGREGATOR_SOURCE=false   # When true + plugin-x-research loaded, X News API (Grok summaries) votes as XNews source (weight 0.35)
# X_SENTIMENT_ASSETS=BTC,ETH,SOL,HYPE   # Add HIP-3 (e.g. NVDA,AAPL) for list; query uses $SYMBOL OR expanded terms
# X_SENTIMENT_STAGGER_INTERVAL_MS=3600000
# X_SENTIMENT_PRIORITY_ASSETS=BTC,ETH   # When set, these refresh at PRIORITY_STAGGER_MS (e.g. 30 min)
# X_SENTIMENT_PRIORITY_STAGGER_MS=1800000   # 30 min for priority assets (default 30 min, clamped to main stagger)

# X bookmarks → Pine (Rust pipeline in packages/x-bookmarks-pipeline). docs/X-BOOKMARKS-PIPELINE.md
# Requires: Rust/cargo; CEREBRAS_API_KEY + XAI_API_KEY (Anthropic + OpenAI above); bookmark.read scope for fetch.
# X_BOOKMARKS_PIPELINE_ENABLED=true
# X_BOOKMARKS_PIPELINE_AGENTS=VINCE
# X_FETCH_USER_ID=          # numeric user id (or use X_FETCH_USERNAME=)
# X_FETCH_USERNAME=
# X_BOOKMARKS_PIPELINE_ROOT=   # default packages/x-bookmarks-pipeline
# X_BOOKMARKS_PIPELINE_TIMEOUT_MS=1800000
# X_BOOKMARKS_OUTPUT_DIR=      # default data/x-bookmarks-pipeline/output
# X_BOOKMARKS_CACHE_PATH=      # default data/x-bookmarks-pipeline/cache/bookmarks.db
# X_BOOKMARKS_PAPER_QUEUE_PATH=  # default data/x-bookmarks-pipeline/paper-signals.jsonl
# X_BOOKMARKS_PAPER_SIGNAL_TTL_HOURS=72   # overlay freshness for paper bot
# VINCE_PAPER_X_BOOKMARKS_ENABLED=true    # set false to ignore JSONL overlay
# CEREBRAS_API_KEY=
# XAI_API_KEY=

# -----------------------------------------------------------------------------
# ELIZA (CEO — knowledge, research, content)
# -----------------------------------------------------------------------------
ELIZA_DISCORD_APPLICATION_ID=
ELIZA_DISCORD_API_TOKEN=
# ELIZA_KNOWLEDGE_CHANNEL_IDS=
# ELIZA_X_BEARER_TOKEN=   # when set, Eliza uses this instead of X_BEARER_TOKEN
# ELIZA_CACHE_DIR=
# KNOWLEDGE_ROOT=knowledge
# Substack (ikigaistudio.substack.com): RSS feed + optional profile via official API
# SUBSTACK_FEED_URL=https://ikigaistudio.substack.com/feed
# ELIZA_SUBSTACK_LINKEDIN_HANDLE=   # LinkedIn handle linked to Substack (for profile stats; requires API ToS)

# -----------------------------------------------------------------------------
# VINCE (CDO — data, paper bot, options, perps, memes)
# -----------------------------------------------------------------------------
# Dexter artifacts: directory with portfolio_*.json; optional .dexter/scorecard.json and .dexter/cache/
# Runbook: docs/DEXTER_ARTIFACT_SYNC_RUNBOOK.md
# DEXTER_ARTIFACT_ROOT=
# Import Dexter FD cache into .elizadb/financialdatasets-cache/ during FD discovery weekly task
# VINCE_DEXTER_CACHE_IMPORT=false
VINCE_DISCORD_APPLICATION_ID=
VINCE_DISCORD_API_TOKEN=
# Pilot: read-only presence context for VINCE runtime
# VINCE_ENABLE_PRESENCE=false

# paste.trade (vendored under packages/paste-trade; self-hosted or SaaS API)
# paste.trade API key (auto-generated on first /trade run)
# You don't need to set this — the skill creates it automatically.
# Only set manually if reusing a key from another client.
# VINCE: the Eliza plugin loads only when PASTE_TRADE_KEY is present at server start.
# After first provision, restart the server so .env is loaded: run once
#   bun run packages/paste-trade/scripts/onboard.ts
# Optional: PASTE_TRADE_ENABLED=false to force off even if a key exists.
# PASTE_TRADE_ENABLED=true
# PASTE_TRADE_KEY=
# API origin (no trailing slash). Same as paste-trade scripts: PASTE_TRADE_URL or:
# PASTE_TRADE_BASE_URL=https://paste.trade
# Optional UI origin for iframe links (defaults to base URL)
# PASTE_TRADE_UI_ORIGIN=
# Poll interval for server-side source snapshots (ms, min 2000)
# PASTE_TRADE_POLL_MS=5000
# YouTube extraction: install yt-dlp on PATH. Dense sources: optional GEMINI_API_KEY (see packages/paste-trade/SKILL.md).

# Paper bot
# Trading mode: conservative | balanced | aggressive (change this first; then tune sliders if needed)
# VINCE_TRADING_MODE=balanced
# VINCE_ENTRY_GATE_ENABLED=false
# VINCE_PAPER_AGGRESSIVE=true
# VINCE_PAPER_FAST_TP=true
# VINCE_PAPER_ASSETS=BTC
# VINCE_PAPER_WTT_ENABLED=true
# VINCE_PAPER_WATCHLIST_ENABLED=true
# When true, TRAIN_ONNX_WHEN_READY applies source weights from the improvement report after each training run (recursive autopilot loop).
# VINCE_APPLY_IMPROVEMENT_WEIGHTS=true
# VINCE_BINANCE_BASE_URL=https://fapi.binance.com
# VINCE_QUIET=true

# Paper bot tuning (no-trades / margin / ONNX). Lower ML threshold or swarm min = more trades; higher margin = larger size.
# Override models dir if agent cwd differs (e.g. absolute path). Unset = ./.elizadb/vince-paper-bot/models
# VINCE_ML_MODELS_DIR=/abs/path/to/vince-paper-bot/models
# VINCE_ML_SIGNAL_QUALITY_THRESHOLD=0.6
# VINCE_SWARM_ENABLED=true
# VINCE_SWARM_MIN_CONFIDENCE=0.5
# VINCE_SWARM_CONSENSUS_THRESHOLD=0.6  # One direction must have this share of weighted vote (e.g. 0.5 = 50%); lower = fewer neutral outcomes
# Swarm neutral override: when swarm is dir=neutral, allow trade if aggregated signal is strong (smaller size). Unset = disabled.
# VINCE_SWARM_NEUTRAL_OVERRIDE_ENABLED=true
# VINCE_SWARM_NEUTRAL_OVERRIDE_MIN_STRENGTH=55
# VINCE_SWARM_NEUTRAL_OVERRIDE_MIN_CONFIDENCE=50
# VINCE_SWARM_NEUTRAL_OVERRIDE_SIZE_MULTIPLIER=0.7
# VINCE_AGGRESSIVE_MARGIN_USD=1000
# VINCE_AGGRESSIVE_BASE_SIZE_PCT=12
# VINCE_PAPER_MAX_SINGLE_TRADE_USD=10000  # Paper bucket + policy cap per trade (default 10k)
# Phase 14 proof engine: observe-only -> recommendation -> auto_apply
# VINCE_PHASE14_PROOF_ENGINE_ENABLED=false
# VINCE_PROOF_ALLOCATOR_MODE=observe_only
# VINCE_PROOF_MIN_SUFFICIENCY_GRADE=MEDIUM
# VINCE_SOURCE_QUALITY_ENABLED=true
# Phase 15 hardening (causal + source quality stability + verified claims)
# VINCE_PHASE15_CAUSAL_MIN_EFFECT=0.02
# VINCE_PHASE15_CAUSAL_MIN_SAMPLES_PER_ARM=12
# VINCE_SOURCE_QUALITY_COOLDOWN_HOURS=24
# VINCE_SOURCE_QUALITY_HYSTERESIS_POINTS=5
# ELIZA_VERIFIED_CLAIMS_MIN_CONFIDENCE=0.6
# Asset-class leverage caps (guardrail; min of per-asset and class cap). Unset = use ASSET_CLASS_MAX_LEVERAGE defaults.
# VINCE_PAPER_MAX_LEVERAGE_EQUITY=5
# VINCE_PAPER_MAX_LEVERAGE_CRYPTO=10
# VINCE_PAPER_MAX_LEVERAGE_COMMODITY=5
# Policy: max trades per day and max open positions (unset = no cap)
# VINCE_PAPER_MAX_DAILY_TRADES=20
# VINCE_PAPER_MAX_OPEN_POSITIONS=15
# Tighter first TP when level 0 (no TP hit) dominates in improvement report (e.g. 0.8 or 1.0)
# VINCE_TP_FIRST_MULTIPLIER=1.0

# Push schedule (channels: name contains "daily" | "lifestyle" | "news")
VINCE_DAILY_REPORT_ENABLED=true
VINCE_DAILY_REPORT_HOUR=18
#
# Phase C — regime bundle handoff (VINCE -> Dexter operators)
# VINCE emits `regime_bundle_v1.json` into Dexter’s artifact root.
#
VINCE_REGIME_BUNDLE_V1_ENABLED=true
VINCE_REGIME_BUNDLE_V1_HOUR_UTC=9
VINCE_REGIME_BUNDLE_V1_MAX_ASSETS=50
#
# Where to write the JSON output.
# Example: `REGIME_BUNDLE_OUT_PATH=.dexter/regime_bundle_v1.json`
#
REGIME_BUNDLE_OUT_PATH=
#
# Phase D — AIHF (optional HTTP read)
# Keep disabled unless you have AIHF deployed and reachable.
#
VINCE_AIH_F_SECOND_OPINION_HTTP_ENABLED=false
# Optional: AIHF can also write the latest cached JSON to a shared file path.
# If set (or if AIHF_ARTIFACT_ROOT is set), VINCE will prefer the file read.
AIHF_LAST_SECOND_OPINION_FILE=
AIHF_ARTIFACT_ROOT=
AIHF_LAST_SECOND_OPINION_MAX_AGE_MS=259200000
AIHF_BASE_URL=
AIHF_LAST_SECOND_OPINION_ENDPOINT=/api/v1/second-opinion/last
AIHF_SECOND_OPINION_READ_TIMEOUT_MS=7000
AIHF_SECOND_OPINION_CACHE_TTL_MS=300000
VINCE_LIFESTYLE_DAILY_ENABLED=true
VINCE_LIFESTYLE_HOUR=8
VINCE_NEWS_DAILY_ENABLED=true
VINCE_NEWS_HOUR=16
# VINCE_NEWS_PUSH_REQUIRE_FRESH=true
# FD cache autoprewarm task (runs inside VINCE runtime)
# VINCE_FD_CACHE_PREWARM_ENABLED=true
# VINCE_FD_CACHE_PREWARM_INTERVAL_HOURS=6
# VINCE_FD_CACHE_MAX_AGE_HOURS=24
# VINCE_FD_CACHE_PREWARM_YEARS=5
# VINCE_FD_CACHE_PREWARM_FORCE=false

# xAI (Grok) — optional for Grok Expert and daily pulse
# XAI_API_KEY=
# XAI_MODEL=
# GROK_SUB_AGENTS_ENABLED=true
# GROK_REGIME_FILTER_ENABLED=false

# -----------------------------------------------------------------------------
# ECHO (CSO — CT sentiment, X pulse, threads)
# -----------------------------------------------------------------------------
ECHO_DISCORD_APPLICATION_ID=
ECHO_DISCORD_API_TOKEN=
# Pilot: read-only presence context for ECHO runtime
# ECHO_ENABLE_PRESENCE=false
# Optional: separate X token for ECHO (what's the trade, X_PULSE, vibe). When set, ECHO uses this instead of X_BEARER_TOKEN.
# ECHO_X_BEARER_TOKEN=
# What's the trade — daily belief-router report (vibe → one trade, ALOHA-style → docs/standup/whats-the-trade/)
ECHO_WHATS_THE_TRADE_ENABLED=true
ECHO_WHATS_THE_TRADE_HOUR=9
# Restrict WTT primary pick to HIP-3 + core perp assets only (default: true)
# Renaissance Fund 3.0: every trade expressible onchain via Hyperliquid
# Set to false to allow offchain stocks, options, Kalshi as primary instrument
ECHO_WTT_HIP3_ONLY=true
# Include Robinhood/Yahoo stock data as offchain context for WTT (default: true)
# Useful color: LLM sees offchain movers but must express via Hyperliquid perp when HIP3_ONLY=true
ECHO_WTT_ROBINHOOD_ENABLED=true
# Optional: Chris Camillo / social-arbitrage lens (information imbalance, pure play, thesis-validity invalidation)
# ECHO_WTT_CAMILLO_STYLE=false
# WHATS_THE_TRADE_SKILL_DIR=skills/whats-the-trade

# -----------------------------------------------------------------------------
# ORACLE (CPO — Polymarket discovery, odds, portfolio)
# -----------------------------------------------------------------------------
ORACLE_DISCORD_APPLICATION_ID=
ORACLE_DISCORD_API_TOKEN=

# -----------------------------------------------------------------------------
# SOLUS (CFO — strike ritual, options, $100K plan; offchain stock specialist)
# -----------------------------------------------------------------------------
SOLUS_DISCORD_APPLICATION_ID=
SOLUS_DISCORD_API_TOKEN=
# FINNHUB_API_KEY=   # Optional: offchain stock quotes and news for Solus watchlist (free tier: 60 calls/min)
# ALPHA_VANTAGE_API_KEY=  # Optional: fallback for stock pulse; free tier 25 req/day. In Cursor/IDE use MCP: https://mcp.alphavantage.co/
# FMP_API_KEY=   # Optional: Financial Modeling Prep (stable API, free tier: 250 req/day) — fundamentals, ratios, earnings for Solus
# SOLUS_X_VIP_HANDLES=
# SOLUS_LAST_WEEK_STRATEGY=
# SOLUS_PORTFOLIO_CONTEXT= (overrides portfolio + open positions from weekly-options-context.md for Solus)
# SOLUS_CURRENT_POSITIONS_PATH=local/solus-current-positions.md  (default; file used when present; local/ is gitignored)

# -----------------------------------------------------------------------------
# OTAKU (COO — DeFi, wallet, BANKR, Relay, Morpho; only agent with funded wallet)
# -----------------------------------------------------------------------------
OTAKU_DISCORD_APPLICATION_ID=
OTAKU_DISCORD_API_TOKEN=

# CDP wallet (Coinbase Developer Platform)
# VITE_CDP_PROJECT_ID=
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# CDP_WALLET_SECRET=
# OTAKU_MODE=degen
# OTAKU_MODE=normies
# OTAKU_AUTO_EXECUTE_ENABLED=false
# OTAKU_AUTO_EXECUTE_MIN_CONFIDENCE=75
#
# Execution safety: BANKR prompt routing, post-trade reconcile, cooldowns (Hyperliquid-style discipline via natural-language prompts)
# OTAKU_RISK_COOLDOWN_ENABLED=true
# OTAKU_RISK_FAIL_THRESHOLD=2
# OTAKU_RISK_COOLDOWN_MS=1800000
# OTAKU_RISK_HARD_STOP_AFTER=0
# OTAKU_RECONCILE_AFTER_TRADE=true
